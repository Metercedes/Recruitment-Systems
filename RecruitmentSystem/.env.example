# Required: AES-256 key, Base64-encoded 32 bytes.  openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Optional: creates an administrator on startup. Without these, no admin account exists.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=

# Set true whenever the application is served over HTTPS.
SESSION_COOKIE_SECURE=false

APP_RECAPTCHA_ENABLED=false
APP_RECAPTCHA_SECRET=
APP_RECAPTCHA_SITEKEY=
